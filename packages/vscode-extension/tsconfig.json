{
	"compilerOptions": {
		"target": "ES2020",
		"lib": ["ES2020"],
		"rootDir": "src",
		"module": "commonjs",
		"strict": true,
		"outDir": "dist",
		"sourceMap": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"skipLibCheck": true
	},
	"exclude": ["node_modules", ".vscode-test"]
}
