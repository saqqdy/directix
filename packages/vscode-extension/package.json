{
	"publisher": "saqqdy",
	"name": "directix-vscode",
	"displayName": "Directix - Vue Directives IntelliSense",
	"icon": "icon.png",
	"description": "IntelliSense for Directix Vue directives library",
	"version": "2.4.0",
	"main": "./dist/extension.js",
	"categories": [
		"Programming Languages",
		"Snippets",
		"Debuggers",
		"Other"
	],
	"scripts": {
		"vscode:prepublish": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node",
		"build": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node",
		"watch": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --watch",
		"lint": "eslint src --ext ts"
	},
	"activationEvents": [
		"onLanguage:vue",
		"onLanguage:html"
	],
	"devDependencies": {
		"@types/node": "^22.19.21",
		"@types/vscode": "^1.125.0",
		"@typescript-eslint/eslint-plugin": "^7.18.0",
		"@typescript-eslint/parser": "^7.18.0",
		"esbuild": "^0.28.1",
		"eslint": "^8.57.1",
		"typescript": "^5.9.3"
	},
	"engines": {
		"vscode": "^1.85.0"
	},
	"keywords": [
		"vue",
		"vue3",
		"vue2",
		"directives",
		"directix",
		"intellisense",
		"debug",
		"performance"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/saqqdy/directix.git",
		"directory": "packages/vscode-extension"
	},
	"contributes": {
		"commands": [
			{
				"command": "directix.openDocs",
				"title": "Directix: Open Documentation"
			},
			{
				"command": "directix.openConfigEditor",
				"title": "Directix: Open Config Editor"
			},
			{
				"command": "directix.showPerfReport",
				"title": "Directix: Show Performance Report"
			},
			{
				"command": "directix.clearPerfData",
				"title": "Directix: Clear Performance Data"
			},
			{
				"command": "directix.inspectState",
				"title": "Directix: Inspect Directive State"
			}
		],
		"snippets": [
			{
				"language": "vue",
				"path": "./snippets/snippets.json"
			}
		],
		"configuration": {
			"title": "Directix",
			"properties": {
				"directix.enableIntelliSense": {
					"type": "boolean",
					"default": true,
					"description": "Enable Directix IntelliSense (completion & hover)"
				},
				"directix.showDocumentation": {
					"type": "boolean",
					"default": true,
					"description": "Show documentation in hover tooltips"
				},
				"directix.enableDiagnostics": {
					"type": "boolean",
					"default": true,
					"description": "Enable real-time diagnostics for directive usage"
				},
				"directix.enablePerformanceTracking": {
					"type": "boolean",
					"default": false,
					"description": "Enable directive performance tracking (may slightly affect editor performance)"
				},
				"directix.diagnostics.debounceMs": {
					"type": "number",
					"default": 500,
					"minimum": 100,
					"maximum": 3000,
					"description": "Debounce interval (ms) for diagnostics analysis"
				},
				"directix.diagnostics.checkDuplicates": {
					"type": "boolean",
					"default": true,
					"description": "Warn about duplicate directive usage on the same element"
				},
				"directix.diagnostics.checkConflicts": {
					"type": "boolean",
					"default": true,
					"description": "Warn about conflicting directive pairs on the same element"
				},
				"directix.diagnostics.checkSSRCompatibility": {
					"type": "boolean",
					"default": true,
					"description": "Warn about SSR-incompatible directives in SSR contexts"
				}
			}
		}
	}
}
