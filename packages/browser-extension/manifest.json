{
	"manifest_version": 3,
	"name": "Directix DevTools",
	"version": "2.4.0",
	"description": "DevTools extension for inspecting Directix Vue directives",
	"icons": {
		"16": "icons/icon16.png",
		"48": "icons/icon48.png",
		"128": "icons/icon128.png"
	},
	"devtools_page": "devtools.html",
	"background": {
		"service_worker": "background/index.js",
		"type": "module"
	},
	"content_scripts": [
		{
			"matches": ["<all_urls>"],
			"js": ["content/index.js"],
			"run_at": "document_idle"
		}
	],
	"permissions": ["activeTab"],
	"host_permissions": ["http://localhost:*/*", "https://*/*"]
}
