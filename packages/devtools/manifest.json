{
	"manifest_version": 3,
	"name": "Directix DevTools",
	"version": "1.0.0",
	"description": "Inspect and debug Directix Vue directives",
	"icons": {
		"16": "icons/icon16.png",
		"48": "icons/icon48.png",
		"128": "icons/icon128.png"
	},
	"devtools_page": "devtools.html",
	"permissions": [],
	"content_security_policy": {
		"extension_pages": "script-src 'self'; object-src 'self'"
	}
}
