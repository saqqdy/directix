{
	"name": "directix",
	"description": "A comprehensive, easy-to-use, and high-performance Vue custom directives library supporting both Vue 2 and Vue 3, with Web Components support",
	"type": "module",
	"version": "2.5.0",
	"packageManager": "pnpm@9.15.9",
	"main": "dist/index.cjs",
	"module": "dist/index.mjs",
	"unpkg": "dist/index.iife.min.js",
	"jsdelivr": "dist/index.iife.min.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"browser": "./dist/index.mjs",
			"require": "./dist/index.cjs",
			"import": "./dist/index.mjs"
		},
		"./nuxt": {
			"types": "./dist/nuxt/index.d.ts",
			"require": "./dist/nuxt/index.cjs",
			"import": "./dist/nuxt/index.mjs"
		},
		"./core": {
			"types": "./dist/packages/core.d.ts",
			"import": "./dist/packages/core.mjs"
		},
		"./shared": {
			"types": "./dist/packages/shared.d.ts",
			"import": "./dist/packages/shared.mjs"
		},
		"./i18n": {
			"types": "./dist/packages/i18n.d.ts",
			"import": "./dist/packages/i18n.mjs"
		},
		"./composables": {
			"types": "./dist/composables.d.ts",
			"import": "./dist/composables.mjs"
		},
		"./style.css": "./dist/style.css"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"dev": "vite",
		"dev:playground": "pnpm --dir playground dev",
		"build": "vite build && tsx scripts/minify && tsx scripts/build-nuxt",
		"build:optimized": "tsx scripts/build-optimized",
		"build:size": "tsx scripts/bundle-size",
		"build:types": "vue-tsc --declaration --emitDeclarationOnly --outDir dist",
		"build:playground": "pnpm --dir playground build",
		"watch": "vite build --watch",
		"clean": "rm -rf dist es lib temp coverage playwright-report",
		"docs:dev": "vitepress dev docs",
		"docs:build": "vitepress build docs",
		"docs:preview": "vitepress preview docs",
		"deploy": "sh scripts/deploy.sh",
		"deploy:playground": "pnpm --dir playground deploy local",
		"gen:version": "tsx scripts/version",
		"tag:version": "tsx scripts/tag",
		"pub": "tsx scripts/publish",
		"unpub": "tsx scripts/unpublish",
		"sync": "tsx scripts/sync",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"test:e2e:debug": "playwright test --debug",
		"test:all": "pnpm test && pnpm test:e2e",
		"lint": "eslint --fix .",
		"typecheck": "vue-tsc --noEmit",
		"example:dev": "pnpm --dir examples/vue3 dev",
		"example:build": "pnpm --dir examples/vue3 build",
		"prepare": "pnpm build",
		"prepublishOnly": "pnpm lint && pnpm typecheck && pnpm test"
	},
	"devDependencies": {
		"@eslint-sets/eslint-config": "^6.3.1",
		"@nuxt/kit": "^3.21.8",
		"@nuxt/schema": "^3.21.8",
		"@playwright/test": "^1.61.0",
		"@types/node": "^22.19.21",
		"@vitejs/plugin-vue": "^5.2.4",
		"@vitest/coverage-v8": "^3.2.6",
		"@vue/test-utils": "^2.4.11",
		"esbuild": "^0.28.1",
		"eslint": "^9.39.4",
		"jsdom": "^26.1.0",
		"nuxt": "^4.4.8",
		"terser": "^5.48.0",
		"tinybench": "^6.0.2",
		"tsx": "^4.22.4",
		"typescript": "^5.9.3",
		"vite": "^6.4.3",
		"vite-plugin-dts": "^4.5.4",
		"vitepress": "^1.6.4",
		"vitest": "^3.2.6",
		"vue": "^3.5.38",
		"vue-tsc": "^2.2.12",
		"vue2": "npm:vue@^2.7.16"
	},
	"peerDependencies": {
		"@nuxt/kit": ">=3.0.0",
		"@nuxt/schema": ">=3.0.0",
		"@vue/composition-api": ">=1.0.0",
		"lottie-web": ">=5.0.0",
		"vue": "^2.0.0 || >=3.0.0"
	},
	"peerDependenciesMeta": {
		"@nuxt/kit": {
			"optional": true
		},
		"@nuxt/schema": {
			"optional": true
		},
		"@vue/composition-api": {
			"optional": true
		},
		"lottie-web": {
			"optional": true
		}
	},
	"engines": {
		"node": ">=16.14"
	},
	"sideEffects": [
		"**/*.css",
		"**/style.css",
		"src/index.ts",
		"src/install.ts",
		"packages/core/src/index.ts",
		"packages/i18n/src/index.ts"
	],
	"keywords": [
		"vue",
		"vue2",
		"vue3",
		"directives",
		"v-click-outside",
		"v-lazy",
		"v-copy",
		"v-debounce",
		"v-throttle",
		"v-permission",
		"v-long-press",
		"v-infinite-scroll",
		"v-loading",
		"v-ripple",
		"v-watermark",
		"v-tooltip",
		"v-hotkey",
		"v-intersect",
		"v-resize",
		"v-focus",
		"v-visible",
		"v-draggable",
		"v-skeleton",
		"v-ellipsis",
		"v-truncate",
		"v-highlight",
		"v-sanitize",
		"v-fullscreen",
		"v-context-menu",
		"v-image-preview",
		"v-lottie",
		"v-touch",
		"v-swipe",
		"v-pan",
		"v-pinch",
		"v-rotate-gesture",
		"v-parallax",
		"v-typewriter",
		"v-countdown",
		"v-counter",
		"v-progress",
		"v-emoji",
		"v-money",
		"v-number",
		"v-mask",
		"v-trim",
		"v-uppercase",
		"v-lowercase",
		"v-capitalcase",
		"v-blur",
		"v-hover",
		"v-fade",
		"v-click-wave",
		"v-click-delay",
		"v-mutation",
		"v-scroll",
		"v-sticky",
		"v-print",
		"v-export",
		"v-virtual-list",
		"v-pull-refresh",
		"typescript"
	],
	"license": "MIT",
	"author": "saqqdy <https://github.com/saqqdy>",
	"homepage": "https://github.com/saqqdy/directix#readme",
	"bugs": {
		"url": "https://github.com/saqqdy/directix/issues"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/saqqdy/directix.git"
	},
	"funding": "https://github.com/sponsors/saqqdy",
	"publishConfig": {
		"access": "public"
	}
}