{
	"name": "directix",
	"description": "A comprehensive, easy-to-use, and high-performance Vue custom directives library supporting both Vue 2 and Vue 3",
	"type": "module",
	"version": "1.0.0",
	"packageManager": "pnpm@9.1.3",
	"main": "./dist/index.cjs.js",
	"module": "./dist/index.esm.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"require": "./dist/index.cjs.js",
			"import": "./dist/index.esm.js"
		},
		"./style.css": "./dist/style.css"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"dev": "vite",
		"gen:version": "tsx scripts/version",
		"tag:version": "tsx scripts/tag",
		"build": "vite build",
		"build:types": "vue-tsc --emitDeclarationOnly --outDir dist",
		"docs:dev": "vitepress dev docs",
		"docs:build": "vitepress build docs",
		"docs:preview": "vitepress preview docs",
		"deploy": "sh scripts/deploy.sh",
		"watch": "vite build --watch",
		"pub": "tsx scripts/publish",
		"unpub": "tsx scripts/unpublish",
		"sync": "tsx scripts/sync",
		"clean": "rm -rf dist es lib temp coverage",
		"dist": "pnpm lint && pnpm build",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"lint": "eslint --fix .",
		"typecheck": "vue-tsc --noEmit",
		"example:dev": "pnpm --dir examples/vue3 dev",
		"example:build": "pnpm --dir examples/vue3 build"
	},
	"devDependencies": {
		"@eslint-sets/eslint-config": "^6.2.0",
		"@types/node": "^22.0.0",
		"@vitejs/plugin-vue": "^5.0.0",
		"@vitest/coverage-v8": "^3.0.0",
		"@vue/test-utils": "^2.4.0",
		"eslint": "^9.0.0",
		"jsdom": "^26.0.0",
		"terser": "^5.46.1",
		"tsx": "^4.0.0",
		"typescript": "^5.0.0",
		"vite": "^6.0.0",
		"vite-plugin-dts": "^4.0.0",
		"vitepress": "^1.6.0",
		"vitest": "^3.0.0",
		"vue": "^3.5.0",
		"vue-tsc": "^2.0.0"
	},
	"peerDependencies": {
		"vue": "^2.6.0 || ^3.0.0"
	},
	"engines": {
		"node": ">=12.20"
	},
	"sideEffects": [
		"**/*.css"
	],
	"keywords": [
		"vue",
		"vue2",
		"vue3",
		"directive",
		"directives",
		"v-click-outside",
		"v-lazy",
		"v-copy",
		"v-debounce",
		"v-throttle",
		"v-permission",
		"typescript"
	],
	"license": "MIT",
	"author": "saqqdy",
	"homepage": "https://github.com/saqqdy/directix#readme",
	"bugs": {
		"url": "https://github.com/saqqdy/directix/issues"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/saqqdy/directix.git"
	}
}
