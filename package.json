{
	"name": "directix",
	"description": "A comprehensive, easy-to-use, and high-performance Vue custom directives library supporting both Vue 2 and Vue 3",
	"type": "module",
	"version": "1.4.1",
	"packageManager": "pnpm@9.15.9",
	"main": "dist/index.cjs",
	"module": "dist/index.mjs",
	"unpkg": "dist/index.iife.min.js",
	"jsdelivr": "dist/index.iife.min.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"require": "./dist/index.cjs",
			"import": "./dist/index.mjs"
		},
		"./style.css": "./dist/style.css"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"dev": "vite",
		"gen:version": "tsx scripts/version",
		"tag:version": "tsx scripts/tag",
		"build": "vite build && tsx scripts/minify",
		"build:types": "vue-tsc --emitDeclarationOnly --outDir dist",
		"docs:dev": "vitepress dev docs",
		"docs:build": "vitepress build docs",
		"docs:preview": "vitepress preview docs",
		"deploy": "sh scripts/deploy.sh",
		"watch": "vite build --watch",
		"pub": "tsx scripts/publish",
		"unpub": "tsx scripts/unpublish",
		"sync": "tsx scripts/sync",
		"clean": "rm -rf dist es lib temp coverage",
		"dist": "pnpm lint && pnpm build",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"lint": "eslint --fix .",
		"typecheck": "vue-tsc --noEmit",
		"example:dev": "pnpm --dir examples/vue3 dev",
		"example:build": "pnpm --dir examples/vue3 build"
	},
	"dependencies": {
		"chart.js": "^4.5.1",
		"lottie-web": "^5.13.0"
	},
	"devDependencies": {
		"@eslint-sets/eslint-config": "^6.3.1",
		"@types/node": "^22.19.15",
		"@vitejs/plugin-vue": "^5.2.4",
		"@vitest/coverage-v8": "^3.2.4",
		"@vue/test-utils": "^2.4.6",
		"eslint": "^9.39.4",
		"jsdom": "^26.1.0",
		"terser": "^5.46.1",
		"tsx": "^4.21.0",
		"typescript": "^5.9.3",
		"vite": "^6.4.1",
		"vite-plugin-dts": "^4.5.4",
		"vitepress": "^1.6.4",
		"vitest": "^3.2.4",
		"vue": "^3.5.31",
		"vue-tsc": "^2.2.12",
		"vue2": "npm:vue@^2.7.16"
	},
	"peerDependencies": {
		"vue": "^2.0.0 || >=3.0.0"
	},
	"engines": {
		"node": ">=12.20"
	},
	"sideEffects": [
		"**/*.css"
	],
	"keywords": [
		"vue",
		"vue2",
		"vue3",
		"directive",
		"directives",
		"v-click-outside",
		"v-lazy",
		"v-copy",
		"v-debounce",
		"v-throttle",
		"v-permission",
		"typescript"
	],
	"license": "MIT",
	"author": "saqqdy <https://github.com/saqqdy>",
	"homepage": "https://github.com/saqqdy/directix#readme",
	"bugs": {
		"url": "https://github.com/saqqdy/directix/issues"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/saqqdy/directix.git"
	}
}
