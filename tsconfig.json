{
	"compilerOptions": {
		"target": "ES2020",
		"jsx": "preserve",
		"lib": ["ES2020", "DOM", "DOM.Iterable"],
		"useDefineForClassFields": true,

		/* Paths */
		"module": "ESNext",

		/* Bundler mode */
		"moduleResolution": "bundler",
		"paths": {
			"@/*": ["./src/*"],
			"@directix/core": ["./packages/core/src"],
			"@directix/shared": ["./packages/shared/src"],
			"@directix/i18n": ["./packages/i18n/src"],
			"#app": ["./node_modules/nuxt/dist/app"],
			"#imports": ["./node_modules/nuxt/dist/app/imports"]
		},
		"resolveJsonModule": true,

		"types": ["vitest/globals", "node"],
		"allowImportingTsExtensions": true,

		/* Linting */
		"strict": true,
		"noFallthroughCasesInSwitch": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noEmit": true,
		"isolatedModules": true,
		"skipLibCheck": true
	},
	"include": [
		"src/**/*.ts",
		"src/**/*.d.ts",
		"src/**/*.tsx",
		"src/**/*.vue",
		"packages/**/*.ts",
		"packages/**/*.vue",
		"tests/**/*.ts",
		"docs/.vitepress/**/*.ts",
		"docs/.vitepress/**/*.vue"
	],
	"exclude": ["node_modules", "dist", "tests", "packages/devtools"]
}
